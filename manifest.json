{
  "manifest_version": 3,
  "name": "Chrome MCP Bridge (clean-room)",
  "version": "1.0.0",
  "description": "Clean-room replacement extension for mcp-chrome-bridge: connects to the com.chromemcp.nativehost native host and powers a fully local MCP server with complete browser control.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "webRequest",
    "debugger",
    "downloads",
    "history",
    "bookmarks",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Chrome MCP Bridge",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/console-capture-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/console-capture.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
